# ==============================================================================
# AI News Hub ("Signal") — Environment Variables Configuration
# ==============================================================================
# Never commit your real .env file. Copy this file to .env and fill in your keys:
# cp .env.example .env

# Phase 3 — Supabase Database & Authentication
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# 1. VITE_SUPABASE_URL: Project URL (e.g., https://xyzcompany.supabase.co)
# 2. VITE_SUPABASE_ANON_KEY: Project API anon/public key (safe for browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Note: The service role key is NEVER used by the browser client.
# Keep SUPABASE_SERVICE_ROLE_KEY strictly server-side if used in future serverless jobs.

# Phase 5 — Server-Side AI Intelligence Provider
# IMPORTANT SECURITY RULES:
# 1. AI API keys MUST be configured strictly server-side (in Vercel project settings or local .env).
# 2. NEVER prefix with VITE_ (e.g. NEVER use VITE_AI_API_KEY). Doing so exposes the key in frontend client bundles.
# 3. Supported providers:
#    - Google Gemini (API key starting with AIza, or GEMINI_API_KEY)
#    - OpenAI (API key starting with sk-, or OPENAI_API_KEY)
#    - Generic provider (AI_API_KEY)
# 4. If no AI key is configured, Signal displays an honest "AI provider not configured" notice
#    and never fabricates fake AI answers.
AI_API_KEY=your-server-side-ai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

